<!-- <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Travel Agent</title>

  <link rel="stylesheet" href="/css/style.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  >
</head>

<body>
  <div class="animated-bg"></div>

  <nav class="navbar">
    <div class="nav-inner">
      <div class="brand">AI Travel<span class="dot">.</span></div>

      <div class="nav-links">
        <a href="#">Flights</a>
        <a href="#">Hotels</a>
        <a href="#">Budget</a>
        <a href="#">Weather</a>
      </div>

      <div class="nav-actions">
        <button class="btn-ghost" type="button">Smart Planner</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <section class="hero">
      <h2>Plan your next trip with AI</h2>
      <p>
        Search flights, hotels, budget details, visa notes and travel recommendations in one smart dashboard.
      </p>
    </section>

    <header>
      <h1>AI Travel Agent</h1>
      <p class="subtitle">
        Enter your travel query below. Example: Find flights from JFK to LHR and 4 star hotels in London from 2026-10-01 to 2026-10-07 for 1 adult.
      </p>
    </header>

    <section class="search-panel">
      <form id="travelForm">
        <textarea
          id="query"
          placeholder="Example: Find flights from JFK to LHR and 4 star hotels in London from 2026-10-01 to 2026-10-07 for 1 adult"
        ></textarea>

        <div class="controls">
          <button class="btn-primary" type="submit">
            Generate Travel Plan
          </button>

          <button class="btn-ghost" type="button" id="clearBtn">
            Clear
          </button>
        </div>
      </form>
    </section>

    <section class="result">
      <div id="resultBox"></div>
    </section>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const backendBaseUrl = "<%= backendUrl || 'http://localhost:8000' %>";
      const API_URL = `${backendBaseUrl}/travel`;

      const form = document.getElementById("travelForm");
      const queryInput = document.getElementById("query");
      const resultBox = document.getElementById("resultBox");
      const clearBtn = document.getElementById("clearBtn");

      if (!form || !queryInput || !resultBox) {
        console.error("Required HTML elements missing: travelForm, query, or resultBox");
        return;
      }

      clearBtn.addEventListener("click", function () {
        queryInput.value = "";
        resultBox.innerHTML = "";
      });

      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        const query = queryInput.value.trim();

        if (!query) {
          resultBox.innerHTML = `
            <div class="empty-state">
              <div>
                <strong>Please enter your travel query</strong>
                <p>Example: Find flights from JFK to LHR and hotels in London from 2026-10-01 to 2026-10-07.</p>
              </div>
            </div>
          `;
          return;
        }

        resultBox.innerHTML = `
          <div class="results-wrapper">
            <div class="spinner"></div>
            <div class="empty-state">
              <div>
                <strong>Creating your travel plan...</strong>
                <p>Finding flights, hotels and trip details. This may take a few seconds.</p>
              </div>
            </div>
          </div>
        `;

        try {
          const response = await fetch(API_URL, {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ query })
          });

          const result = await response.json();

          console.log("FULL BACKEND RESPONSE:", result);

          if (!response.ok) {
            throw new Error(result.detail || "Backend error");
          }

          const travelData = normalizeTravelResponse(result);
          renderTravelPlan(travelData, result.thread_id);

        } catch (error) {
          console.error("Frontend error:", error);

          resultBox.innerHTML = `
            <div class="alert">
              <strong>Something went wrong.</strong>
              <p>${escapeHtml(error.message)}</p>
              <p>Make sure backend is running on ${backendBaseUrl}</p>
            </div>
          `;
        }
      });

      function normalizeTravelResponse(result) {
        let data = result.data || result;

        if (typeof data === "string") {
          try {
            data = JSON.parse(data);
          } catch (e) {
            return {
              flights: [],
              hotels: [],
              weather: null,
              visa: null,
              budget: null,
              rawText: data
            };
          }
        }

        if (!data || typeof data !== "object") {
          data = {};
        }

        const rawOutput = result.raw_output || "";

        let parsedRaw = null;

        if (typeof rawOutput === "string") {
          try {
            parsedRaw = JSON.parse(rawOutput);
          } catch (e) {
            parsedRaw = null;
          }
        }

        const finalData = parsedRaw || data;

        return {
          flights:
            finalData.flights ||
            finalData.flight_options ||
            finalData.best_flights ||
            finalData.other_flights ||
            finalData.flight_results ||
            [],

          hotels:
            finalData.hotels ||
            finalData.hotel_options ||
            finalData.properties ||
            finalData.hotel_results ||
            [],

          weather:
            finalData.weather ||
            finalData.weather_info ||
            null,

          visa:
            finalData.visa ||
            finalData.visa_information ||
            finalData.visa_info ||
            null,

          budget:
            finalData.budget ||
            finalData.budget_analysis ||
            null,

          rawText:
            typeof rawOutput === "string" ? rawOutput : ""
        };
      }

      function renderTravelPlan(data, threadId) {
        const flights = Array.isArray(data.flights) ? data.flights : [];
        const hotels = Array.isArray(data.hotels) ? data.hotels : [];
        const computedBudget = calculateBudget(flights, hotels);

        resultBox.innerHTML = `
          <div class="results-wrapper fade-in-up">
            <div class="results-header">
              <div>
                <div class="eyebrow">AI Generated Plan</div>
                <h2>Your Travel Dashboard</h2>
                <p class="results-subtitle">
                  Curated flights, hotels, budget, weather and visa information in one clean view.
                </p>
              </div>

              <div class="result-meta">
                <span class="result-badge">✈️ Flights: ${flights.length}</span>
                <span class="result-badge">🏨 Hotels: ${hotels.length}</span>
              </div>
            </div>

            <div class="dashboard-grid">
              <div class="panel panel-large">
                <div class="panel-title">
                  <h3>✈️ Flight Options</h3>
                  <span class="panel-chip">${flights.length || 0} found</span>
                </div>
                ${renderFlights(flights)}
              </div>

              <div class="panel panel-small">
                <div class="panel-title">
                  <h3>🌤️ Weather</h3>
                </div>
                ${renderWeather(data.weather)}
              </div>

              <div class="panel panel-large">
                <div class="panel-title">
                  <h3>🏨 Hotel Options</h3>
                  <span class="panel-chip">${hotels.length || 0} found</span>
                </div>
                ${renderHotels(hotels)}
              </div>

              <div class="panel panel-budget">
                <div class="panel-title">
                  <h3>💰 Budget</h3>
                </div>
                ${renderBudget(data.budget, computedBudget)}
              </div>

              <div class="panel panel-small">
                <div class="panel-title">
                  <h3>🛂 Visa Information</h3>
                </div>
                ${renderVisa(data.visa)}
              </div>

              ${data.rawText ? `
                <div class="panel panel-large">
                  <div class="panel-title">
                    <h3>📝 Agent Response</h3>
                  </div>
                  ${renderRawText(data.rawText)}
                </div>
              ` : ""}
            </div>
          </div>
        `;
      }

      function renderFlights(flights) {
        if (!flights.length) {
          return `
            <div class="empty-state">
              <div>
                <strong>No flight data available</strong>
                <p>Backend did not return flight options. Try future dates like 2026-10-01.</p>
              </div>
            </div>
          `;
        }

        const cards = flights.slice(0, 6).map((flight, index) => {
          const airline = getFlightAirline(flight);
          const departure = getValue(flight, ["departure_airport", "departure", "from", "departure_id"], "Departure");
          const arrival = getValue(flight, ["arrival_airport", "arrival", "to", "arrival_id"], "Arrival");
          const route = getValue(flight, ["route"], `${departure} → ${arrival}`);
          const duration = getValue(flight, ["duration", "total_duration"], "N/A");
          const price = getPrice(flight);
          const stops = getValue(flight, ["stops", "layovers"], "N/A");
          const link = getValue(flight, ["booking_link", "link", "url"], "#");
          const image = getFlightImage(airline);

          return `
            <div class="result-card">
              <div class="image-wrap">
                <img class="flight-image" src="${image}" alt="${escapeHtml(airline)} flight" />
                <span class="image-badge">Flight ${index + 1}</span>
              </div>

              <div class="card-header-row">
                <div>
                  <div class="card-kicker">Airline</div>
                  <h4>${escapeHtml(airline)}</h4>
                </div>
                <div class="price-pill">${price ? "$" + price : "N/A"}</div>
              </div>

              <div class="card-body-list">
                <div>
                  <span>Route</span>
                  <strong>${escapeHtml(route)}</strong>
                </div>
                <div>
                  <span>Duration</span>
                  <strong>${escapeHtml(String(duration))}</strong>
                </div>
                <div>
                  <span>Stops</span>
                  <strong>${escapeHtml(String(stops))}</strong>
                </div>
              </div>

              ${link !== "#" ? `
                <a class="btn-link" href="${link}" target="_blank" rel="noopener noreferrer">Book Flight</a>
              ` : `
                <span class="muted">Booking link not available</span>
              `}
            </div>
          `;
        }).join("");

        return `<div class="card-grid">${cards}</div>`;
      }

      function renderHotels(hotels) {
        if (!hotels.length) {
          return `
            <div class="empty-state">
              <div>
                <strong>No hotel data available</strong>
                <p>Backend did not return hotel options. Try a city name and future dates.</p>
              </div>
            </div>
          `;
        }

        const cards = hotels.slice(0, 6).map((hotel, index) => {
          const name = getValue(hotel, ["name", "title"], "Hotel");
          const location = getValue(hotel, ["location", "address", "neighborhood"], "Location not available");
          const rating = getValue(hotel, ["rating", "extracted_hotel_class", "hotel_class"], "N/A");
          const price = getPrice(hotel);
          const link = getValue(hotel, ["link", "booking_link", "url"], "#");
          const image = getHotelImageFromData(hotel, name, location);

          const amenities = getHotelAmenities(hotel);

          return `
            <div class="result-card">
              <div class="image-wrap">
                <img class="card-image" src="${image}" alt="${escapeHtml(name)} hotel" />
                <span class="image-badge">⭐ ${escapeHtml(String(rating))}</span>
              </div>

              <div class="card-header-row">
                <div>
                  <div class="card-kicker">Hotel</div>
                  <h4>${escapeHtml(name)}</h4>
                </div>
                <div class="price-pill">${price ? "$" + price : "N/A"}</div>
              </div>

              <div class="card-body-list compact">
                <div>
                  <span>Location</span>
                  <strong>${escapeHtml(location)}</strong>
                </div>
              </div>

              ${amenities.length ? `
                <div class="amenities">
                  ${amenities.slice(0, 4).map(item => `<span>${escapeHtml(item)}</span>`).join("")}
                </div>
              ` : ""}

              ${link !== "#" ? `
                <a class="btn-link" href="${link}" target="_blank" rel="noopener noreferrer">View Hotel</a>
              ` : `
                <span class="muted">Hotel link not available</span>
              `}
            </div>
          `;
        }).join("");

        return `<div class="card-grid">${cards}</div>`;
      }

      function renderWeather(weather) {
        if (!weather || typeof weather !== "object" || Object.keys(weather).length === 0) {
          return `
            <div class="mini-card-content">
              <div class="mini-icon">🌤️</div>
              <div>
                <h4>Weather unavailable</h4>
                <p class="muted">
                  Your backend weather endpoint is still dummy. Connect WeatherAPI or OpenWeather to show real temperature.
                </p>
              </div>
            </div>
          `;
        }

        const temp = getValue(weather, ["temperature", "temp", "current_temp"], "N/A");
        const condition = getValue(weather, ["condition", "description", "summary"], "Weather information");
        const city = getValue(weather, ["city", "location", "destination"], "Destination");

        return `
          <div class="weather-mini">
            <div class="mini-card-content">
              <div class="mini-icon">🌤️</div>
              <div>
                <h4>${escapeHtml(city)}</h4>
                <p class="muted">${escapeHtml(condition)}</p>
              </div>
            </div>

            <div class="weather-temp">${escapeHtml(String(temp))}°C</div>
          </div>
        `;
      }

      function renderVisa(visa) {
        if (!visa || typeof visa !== "object" || Object.keys(visa).length === 0) {
          return `
            <div class="mini-card-content">
              <div class="mini-icon">🛂</div>
              <div>
                <h4>Visa details unavailable</h4>
                <p class="muted">
                  Add nationality and destination country in the query to generate visa information.
                </p>
              </div>
            </div>
          `;
        }

        const required = getValue(visa, ["required", "visa_required", "status"], "Check required");
        const details = getValue(visa, ["details", "message", "notes", "summary"], "");

        return `
          <div class="mini-card-content">
            <div class="mini-icon">🛂</div>
            <div>
              <h4>Required: ${escapeHtml(String(required))}</h4>
              <p class="visa-summary">${escapeHtml(String(details))}</p>
            </div>
          </div>
        `;
      }

      function renderBudget(budget, computedBudget) {
        const finalBudget = {
          totalFlightCost: Number(budget?.total_flight_cost || budget?.flight_cost || computedBudget.totalFlightCost || 0),
          totalHotelCost: Number(budget?.total_hotel_cost || budget?.hotel_cost || computedBudget.totalHotelCost || 0),
          totalTripCost: Number(budget?.total_trip_cost || budget?.total_cost || computedBudget.totalTripCost || 0),
          budget: Number(budget?.budget || computedBudget.budget || 0),
          remaining: Number(budget?.remaining || computedBudget.remaining || 0)
        };

        const progress = finalBudget.budget > 0
          ? Math.min((finalBudget.totalTripCost / finalBudget.budget) * 100, 100)
          : finalBudget.totalTripCost > 0
            ? 65
            : 0;

        return `
          <div class="budget-card">
            <div class="budget-metrics">
              <div>
                <span>Flight Cost</span>
                <strong>$${formatNumber(finalBudget.totalFlightCost)}</strong>
              </div>

              <div>
                <span>Hotel Cost</span>
                <strong>$${formatNumber(finalBudget.totalHotelCost)}</strong>
              </div>

              <div>
                <span>Total Trip</span>
                <strong>$${formatNumber(finalBudget.totalTripCost)}</strong>
              </div>

              <div>
                <span>Remaining</span>
                <strong>$${formatNumber(finalBudget.remaining)}</strong>
              </div>
            </div>

            <div class="budget-progress-wrap">
              <div class="budget-progress">
                <span style="width: ${progress}%"></span>
              </div>
              <div class="budget-progress-label">
                ${finalBudget.totalTripCost > 0
                  ? "Estimated from available flight and hotel prices."
                  : "Budget is empty because backend did not return numeric prices."}
              </div>
            </div>
          </div>
        `;
      }

      function renderRawText(text) {
        return `<pre class="raw-text">${escapeHtml(text)}</pre>`;
      }

      function getValue(obj, keys, fallback = "") {
        for (const key of keys) {
          if (obj && obj[key] !== undefined && obj[key] !== null && obj[key] !== "") {
            if (typeof obj[key] === "object") {
              if (obj[key].name) return obj[key].name;
              if (obj[key].code) return obj[key].code;
              return JSON.stringify(obj[key]);
            }
            return obj[key];
          }
        }
        return fallback;
      }

      function getFlightAirline(flight) {
        if (flight.airline) return flight.airline;
        if (flight.name) return flight.name;
        if (flight.carrier) return flight.carrier;

        if (Array.isArray(flight.flights) && flight.flights.length) {
          return flight.flights[0].airline || flight.flights[0].flight_number || "Airline";
        }

        return "Airline";
      }

      function getPrice(item) {
        const possiblePrice =
          item.price ||
          item.price_total ||
          item.extracted_price ||
          item.total_price ||
          item.rate_per_night?.extracted_lowest ||
          item.total_rate?.extracted_lowest ||
          item.price?.extracted ||
          item.price?.value;

        if (!possiblePrice) return 0;

        if (typeof possiblePrice === "number") return Math.round(possiblePrice);

        const cleaned = String(possiblePrice).replace(/[^0-9.]/g, "");
        return Math.round(Number(cleaned)) || 0;
      }

      function calculateBudget(flights, hotels) {
        const flightPrices = flights.map(getPrice).filter(price => price > 0);
        const hotelPrices = hotels.map(getPrice).filter(price => price > 0);

        const totalFlightCost = flightPrices.length ? flightPrices[0] : 0;
        const totalHotelCost = hotelPrices.length ? hotelPrices[0] : 0;
        const totalTripCost = totalFlightCost + totalHotelCost;

        return {
          totalFlightCost,
          totalHotelCost,
          totalTripCost,
          budget: 0,
          remaining: 0
        };
      }

      function getHotelAmenities(hotel) {
        const amenities =
          hotel.amenities ||
          hotel.extensions ||
          hotel.features ||
          [];

        if (Array.isArray(amenities)) {
          return amenities.map(item => String(item));
        }

        return [];
      }

      function getHotelImageFromData(hotel, name, location) {
        return (
          hotel.thumbnail ||
          hotel.image ||
          hotel.image_url ||
          hotel.images?.[0]?.thumbnail ||
          hotel.images?.[0]?.original_image ||
          hotel.images?.[0] ||
          getFallbackHotelImage(name, location)
        );
      }

      function getFallbackHotelImage(name, location) {
        const search = encodeURIComponent(`${name} ${location} hotel`);
        return `https://source.unsplash.com/800x500/?hotel,travel,${search}`;
      }

      function getFlightImage(airline) {
        const query = encodeURIComponent(`${airline} airplane`);
        return `https://source.unsplash.com/800x400/?airplane,flight,${query}`;
      }

      function formatNumber(value) {
        return Number(value || 0).toLocaleString();
      }

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }
    });
  </script>
</body>
</html> -->





<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Travel Agent</title>

  <link rel="stylesheet" href="/css/style.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  >
</head>

<body>
  <div class="animated-bg"></div>

  <nav class="navbar">
    <div class="nav-inner">
      <div class="brand">AI Travel<span class="dot">.</span></div>

      <div class="nav-links">
        <a href="#">Flights</a>
        <a href="#">Hotels</a>
        <a href="#">Budget</a>
        <a href="#">Weather</a>
      </div>

      <div class="nav-actions">
        <button class="btn-ghost" type="button">Smart Planner</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-eyebrow">✦ AI-Powered Travel Planning</div>
        <h2>
          Plan Your <span class="gradient-text">Dream Trip</span> with AI —
          Personalized Travel Planning in Seconds
        </h2>
        <p>
          Search flights, hotels, budget details, visa notes and travel recommendations in one smart dashboard. Just describe your trip and let AI handle the rest.
        </p>
        <div class="hero-ctas">
          <a href="#travelForm" class="btn-hero-primary">🚀 Start Planning Free</a>
          <a href="#features" class="btn-hero-secondary">How It Works</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <strong>120+</strong>
            <span>Countries Covered</span>
          </div>
          <div class="hero-stat">
            <strong>50K+</strong>
            <span>Trips Planned</span>
          </div>
          <div class="hero-stat">
            <strong>4.9★</strong>
            <span>Average Rating</span>
          </div>
          <div class="hero-stat">
            <strong>&lt;10s</strong>
            <span>Avg. Plan Time</span>
          </div>
        </div>
      </div>
    </section>

    <header>
      <h1>AI Travel Agent</h1>
      <p class="subtitle">
        Enter your travel query below. Example: Find flights from JFK to LHR and 4 star hotels in London from 2026-10-01 to 2026-10-07 for 1 adult.
      </p>
    </header>

    <section class="search-panel">
      <form id="travelForm">
        <textarea
          id="query"
          placeholder="Example: Find flights from JFK to LHR and 4 star hotels in London from 2026-10-01 to 2026-10-07 for 1 adult"
        ></textarea>

        <div class="controls">
          <button class="btn-primary" type="submit">
            Generate Travel Plan
          </button>

          <button class="btn-ghost" type="button" id="clearBtn">
            Clear
          </button>
        </div>
      </form>
    </section>

    <section class="result">
      <div id="resultBox"></div>
    </section>

    <section class="features-section reveal" id="features">
      <div class="section-heading">
        <div class="eyebrow">How It Works</div>
        <h2>Your Trip, Planned in Three Simple Steps</h2>
        <p>Our AI agent searches flights, hotels, weather and visa requirements all at once — so you don't have to juggle ten different tabs.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">💬</div>
          <h4>Describe Your Trip</h4>
          <p>Tell us where you're going, when, and your preferences in plain language — no complicated forms.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h4>AI Builds Your Plan</h4>
          <p>Our agent searches flights, hotels, weather, visa rules and budget in real time and assembles a complete dashboard.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🧳</div>
          <h4>Review &amp; Book</h4>
          <p>Compare options side by side, check your budget breakdown, and book directly through trusted partner links.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-brand">AI Travel<span class="dot">.</span></div>
        <p style="max-width: 38ch; line-height: 1.6; font-size: 0.92rem;">
          Your AI-powered co-pilot for flights, hotels, budgets and itineraries — built to make trip planning effortless.
        </p>
      </div>
      <div class="footer-col">
        <h5>Explore</h5>
        <a href="#">Flights</a>
        <a href="#">Hotels</a>
        <a href="#">Budget Planner</a>
        <a href="#">Weather</a>
      </div>
      <div class="footer-col">
        <h5>Company</h5>
        <a href="#">About</a>
        <a href="#">Careers</a>
        <a href="#">Contact</a>
      </div>
      <div class="footer-col">
        <h5>Legal</h5>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
      </div>
    </div>
    <div class="footer-bottom">
      © 2026 AI Travel. All rights reserved.
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const backendBaseUrl = "<%= backendUrl || 'http://localhost:8000' %>";
      const API_URL = `${backendBaseUrl}/travel`;

      const form = document.getElementById("travelForm");
      const queryInput = document.getElementById("query");
      const resultBox = document.getElementById("resultBox");
      const clearBtn = document.getElementById("clearBtn");

      if (!form || !queryInput || !resultBox) {
        console.error("Required HTML elements missing: travelForm, query, or resultBox");
        return;
      }

      clearBtn.addEventListener("click", function () {
        queryInput.value = "";
        resultBox.innerHTML = "";
      });

      // Scroll-reveal animations
      const revealEls = document.querySelectorAll(".reveal");
      if (revealEls.length && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach((el) => observer.observe(el));
      }

      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        const query = queryInput.value.trim();

        if (!query) {
          resultBox.innerHTML = `
            <div class="empty-state">
              <div>
                <strong>Please enter your travel query</strong>
                <p>Example: Find flights from JFK to LHR and hotels in London from 2026-10-01 to 2026-10-07.</p>
              </div>
            </div>
          `;
          return;
        }

        resultBox.innerHTML = `
          <div class="results-wrapper fade-in-up">
            <div class="ai-loading">
              <div class="ai-avatar">✈️</div>
              <div>
                <strong>Creating your travel plan</strong>
                <div class="typing-dots" style="margin-top:6px;">
                  <span></span><span></span><span></span>
                </div>
              </div>
            </div>
            <div class="skeleton-grid">
              <div class="skeleton-card">
                <div class="skeleton-block img"></div>
                <div class="skeleton-block line"></div>
                <div class="skeleton-block line short"></div>
              </div>
              <div class="skeleton-card">
                <div class="skeleton-block img"></div>
                <div class="skeleton-block line"></div>
                <div class="skeleton-block line short"></div>
              </div>
            </div>
          </div>
        `;

        try {
          const response = await fetch(API_URL, {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ query })
          });

          const result = await response.json();

          console.log("FULL BACKEND RESPONSE:", result);

          if (!response.ok) {
            throw new Error(result.detail || "Backend error");
          }

          const travelData = normalizeTravelResponse(result);
          renderTravelPlan(travelData, result.thread_id);

        } catch (error) {
          console.error("Frontend error:", error);

          resultBox.innerHTML = `
            <div class="alert">
              <strong>Something went wrong.</strong>
              <p>${escapeHtml(error.message)}</p>
              <p>Make sure backend is running on ${backendBaseUrl}</p>
            </div>
          `;
        }
      });

      function normalizeTravelResponse(result) {
        let data = result.data || result;

        if (typeof data === "string") {
          try {
            data = JSON.parse(data);
          } catch (e) {
            return {
              flights: [],
              hotels: [],
              weather: null,
              visa: null,
              budget: null,
              rawText: data
            };
          }
        }

        if (!data || typeof data !== "object") {
          data = {};
        }

        const rawOutput = result.raw_output || "";

        let parsedRaw = null;

        if (typeof rawOutput === "string") {
          try {
            parsedRaw = JSON.parse(rawOutput);
          } catch (e) {
            parsedRaw = null;
          }
        }

        const finalData = parsedRaw || data;

        return {
          flights:
            finalData.flights ||
            finalData.flight_options ||
            finalData.best_flights ||
            finalData.other_flights ||
            finalData.flight_results ||
            [],

          hotels:
            finalData.hotels ||
            finalData.hotel_options ||
            finalData.properties ||
            finalData.hotel_results ||
            [],

          weather:
            finalData.weather ||
            finalData.weather_info ||
            null,

          visa:
            finalData.visa ||
            finalData.visa_information ||
            finalData.visa_info ||
            null,

          budget:
            finalData.budget ||
            finalData.budget_analysis ||
            null,

          rawText:
            typeof rawOutput === "string" ? rawOutput : ""
        };
      }

      function renderTravelPlan(data, threadId) {
        const flights = Array.isArray(data.flights) ? data.flights : [];
        const hotels = Array.isArray(data.hotels) ? data.hotels : [];
        const computedBudget = calculateBudget(flights, hotels);

        resultBox.innerHTML = `
          <div class="results-wrapper fade-in-up">
            <div class="results-header">
              <div>
                <div class="eyebrow">AI Generated Plan</div>
                <h2>Your Travel Dashboard</h2>
                <p class="results-subtitle">
                  Curated flights, hotels, budget, weather and visa information in one clean view.
                </p>
              </div>

              <div class="result-meta">
                <span class="result-badge">✈️ Flights: ${flights.length}</span>
                <span class="result-badge">🏨 Hotels: ${hotels.length}</span>
              </div>
            </div>

            <div class="dashboard-grid">
              <div class="panel panel-large">
                <div class="panel-title">
                  <h3>✈️ Flight Options</h3>
                  <span class="panel-chip">${flights.length || 0} found</span>
                </div>
                ${renderFlights(flights)}
              </div>

              <div class="panel panel-small">
                <div class="panel-title">
                  <h3>🌤️ Weather</h3>
                </div>
                ${renderWeather(data.weather)}
              </div>

              <div class="panel panel-large">
                <div class="panel-title">
                  <h3>🏨 Hotel Options</h3>
                  <span class="panel-chip">${hotels.length || 0} found</span>
                </div>
                ${renderHotels(hotels)}
              </div>

              <div class="panel panel-budget">
                <div class="panel-title">
                  <h3>💰 Budget</h3>
                </div>
                ${renderBudget(data.budget, computedBudget)}
              </div>

              <div class="panel panel-small">
                <div class="panel-title">
                  <h3>🛂 Visa Information</h3>
                </div>
                ${renderVisa(data.visa)}
              </div>

              ${data.rawText ? `
                <div class="panel panel-large">
                  <div class="panel-title">
                    <h3>📝 Agent Response</h3>
                  </div>
                  ${renderRawText(data.rawText)}
                </div>
              ` : ""}
            </div>
          </div>
        `;
      }

      function renderFlights(flights) {
        if (!flights.length) {
          return `
            <div class="empty-state">
              <div>
                <strong>No flight data available</strong>
                <p>Backend did not return flight options. Try future dates like 2026-10-01.</p>
              </div>
            </div>
          `;
        }

        const cards = flights.slice(0, 6).map((flight, index) => {
          const airline = getFlightAirline(flight);
          const departure = getValue(flight, ["departure_airport", "departure", "from", "departure_id"], "Departure");
          const arrival = getValue(flight, ["arrival_airport", "arrival", "to", "arrival_id"], "Arrival");
          const route = getValue(flight, ["route"], `${departure} → ${arrival}`);
          const duration = getValue(flight, ["duration", "total_duration"], "N/A");
          const price = getPrice(flight);
          const stops = getValue(flight, ["stops", "layovers"], "N/A");
          const link = getValue(flight, ["booking_link", "link", "url"], "#");
          const image = getFlightImage(airline);

          return `
            <div class="result-card">
              <div class="image-wrap">
                <img class="flight-image" src="${image}" alt="${escapeHtml(airline)} flight" />
                <span class="image-badge">Flight ${index + 1}</span>
              </div>

              <div class="card-header-row">
                <div>
                  <div class="card-kicker">Airline</div>
                  <h4>${escapeHtml(airline)}</h4>
                </div>
                <div class="price-pill">${price ? "$" + price : "N/A"}</div>
              </div>

              <div class="card-body-list">
                <div>
                  <span>Route</span>
                  <strong>${escapeHtml(route)}</strong>
                </div>
                <div>
                  <span>Duration</span>
                  <strong>${escapeHtml(String(duration))}</strong>
                </div>
                <div>
                  <span>Stops</span>
                  <strong>${escapeHtml(String(stops))}</strong>
                </div>
              </div>

              ${link !== "#" ? `
                <a class="btn-link" href="${link}" target="_blank" rel="noopener noreferrer">Book Flight</a>
              ` : `
                <span class="muted">Booking link not available</span>
              `}
            </div>
          `;
        }).join("");

        return `<div class="card-grid">${cards}</div>`;
      }

      function renderHotels(hotels) {
        if (!hotels.length) {
          return `
            <div class="empty-state">
              <div>
                <strong>No hotel data available</strong>
                <p>Backend did not return hotel options. Try a city name and future dates.</p>
              </div>
            </div>
          `;
        }

        const cards = hotels.slice(0, 6).map((hotel, index) => {
          const name = getValue(hotel, ["name", "title"], "Hotel");
          const location = getValue(hotel, ["location", "address", "neighborhood"], "Location not available");
          const rating = getValue(hotel, ["rating", "extracted_hotel_class", "hotel_class"], "N/A");
          const price = getPrice(hotel);
          const link = getValue(hotel, ["link", "booking_link", "url"], "#");
          const image = getHotelImageFromData(hotel, name, location);

          const amenities = getHotelAmenities(hotel);

          return `
            <div class="result-card">
              <div class="image-wrap">
                <img class="card-image" src="${image}" alt="${escapeHtml(name)} hotel" />
                <span class="image-badge">⭐ ${escapeHtml(String(rating))}</span>
              </div>

              <div class="card-header-row">
                <div>
                  <div class="card-kicker">Hotel</div>
                  <h4>${escapeHtml(name)}</h4>
                </div>
                <div class="price-pill">${price ? "$" + price : "N/A"}</div>
              </div>

              <div class="card-body-list compact">
                <div>
                  <span>Location</span>
                  <strong>${escapeHtml(location)}</strong>
                </div>
              </div>

              ${amenities.length ? `
                <div class="amenities">
                  ${amenities.slice(0, 4).map(item => `<span>${escapeHtml(item)}</span>`).join("")}
                </div>
              ` : ""}

              ${link !== "#" ? `
                <a class="btn-link" href="${link}" target="_blank" rel="noopener noreferrer">View Hotel</a>
              ` : `
                <span class="muted">Hotel link not available</span>
              `}
            </div>
          `;
        }).join("");

        return `<div class="card-grid">${cards}</div>`;
      }

      function renderWeather(weather) {
        if (!weather || typeof weather !== "object" || Object.keys(weather).length === 0) {
          return `
            <div class="mini-card-content">
              <div class="mini-icon">🌤️</div>
              <div>
                <h4>Weather unavailable</h4>
                <p class="muted">
                  Your backend weather endpoint is still dummy. Connect WeatherAPI or OpenWeather to show real temperature.
                </p>
              </div>
            </div>
          `;
        }

        const temp = getValue(weather, ["temperature", "temp", "current_temp"], "N/A");
        const condition = getValue(weather, ["condition", "description", "summary"], "Weather information");
        const city = getValue(weather, ["city", "location", "destination"], "Destination");

        return `
          <div class="weather-mini">
            <div class="mini-card-content">
              <div class="mini-icon">🌤️</div>
              <div>
                <h4>${escapeHtml(city)}</h4>
                <p class="muted">${escapeHtml(condition)}</p>
              </div>
            </div>

            <div class="weather-temp">${escapeHtml(String(temp))}°C</div>
          </div>
        `;
      }

      function renderVisa(visa) {
        if (!visa || typeof visa !== "object" || Object.keys(visa).length === 0) {
          return `
            <div class="mini-card-content">
              <div class="mini-icon">🛂</div>
              <div>
                <h4>Visa details unavailable</h4>
                <p class="muted">
                  Add nationality and destination country in the query to generate visa information.
                </p>
              </div>
            </div>
          `;
        }

        const required = getValue(visa, ["required", "visa_required", "status"], "Check required");
        const details = getValue(visa, ["details", "message", "notes", "summary"], "");

        return `
          <div class="mini-card-content">
            <div class="mini-icon">🛂</div>
            <div>
              <h4>Required: ${escapeHtml(String(required))}</h4>
              <p class="visa-summary">${escapeHtml(String(details))}</p>
            </div>
          </div>
        `;
      }

      function renderBudget(budget, computedBudget) {
        const finalBudget = {
          totalFlightCost: Number(budget?.total_flight_cost || budget?.flight_cost || computedBudget.totalFlightCost || 0),
          totalHotelCost: Number(budget?.total_hotel_cost || budget?.hotel_cost || computedBudget.totalHotelCost || 0),
          totalTripCost: Number(budget?.total_trip_cost || budget?.total_cost || computedBudget.totalTripCost || 0),
          budget: Number(budget?.budget || computedBudget.budget || 0),
          remaining: Number(budget?.remaining || computedBudget.remaining || 0)
        };

        const progress = finalBudget.budget > 0
          ? Math.min((finalBudget.totalTripCost / finalBudget.budget) * 100, 100)
          : finalBudget.totalTripCost > 0
            ? 65
            : 0;

        return `
          <div class="budget-card">
            <div class="budget-metrics">
              <div>
                <span>Flight Cost</span>
                <strong>$${formatNumber(finalBudget.totalFlightCost)}</strong>
              </div>

              <div>
                <span>Hotel Cost</span>
                <strong>$${formatNumber(finalBudget.totalHotelCost)}</strong>
              </div>

              <div>
                <span>Total Trip</span>
                <strong>$${formatNumber(finalBudget.totalTripCost)}</strong>
              </div>

              <div>
                <span>Remaining</span>
                <strong>$${formatNumber(finalBudget.remaining)}</strong>
              </div>
            </div>

            <div class="budget-progress-wrap">
              <div class="budget-progress">
                <span style="width: ${progress}%"></span>
              </div>
              <div class="budget-progress-label">
                ${finalBudget.totalTripCost > 0
                  ? "Estimated from available flight and hotel prices."
                  : "Budget is empty because backend did not return numeric prices."}
              </div>
            </div>
          </div>
        `;
      }

      function renderRawText(text) {
        return `<pre class="raw-text">${escapeHtml(text)}</pre>`;
      }

      function getValue(obj, keys, fallback = "") {
        for (const key of keys) {
          if (obj && obj[key] !== undefined && obj[key] !== null && obj[key] !== "") {
            if (typeof obj[key] === "object") {
              if (obj[key].name) return obj[key].name;
              if (obj[key].code) return obj[key].code;
              return JSON.stringify(obj[key]);
            }
            return obj[key];
          }
        }
        return fallback;
      }

      function getFlightAirline(flight) {
        if (flight.airline) return flight.airline;
        if (flight.name) return flight.name;
        if (flight.carrier) return flight.carrier;

        if (Array.isArray(flight.flights) && flight.flights.length) {
          return flight.flights[0].airline || flight.flights[0].flight_number || "Airline";
        }

        return "Airline";
      }

      function getPrice(item) {
        const possiblePrice =
          item.price ||
          item.price_total ||
          item.extracted_price ||
          item.total_price ||
          item.rate_per_night?.extracted_lowest ||
          item.total_rate?.extracted_lowest ||
          item.price?.extracted ||
          item.price?.value;

        if (!possiblePrice) return 0;

        if (typeof possiblePrice === "number") return Math.round(possiblePrice);

        const cleaned = String(possiblePrice).replace(/[^0-9.]/g, "");
        return Math.round(Number(cleaned)) || 0;
      }

      function calculateBudget(flights, hotels) {
        const flightPrices = flights.map(getPrice).filter(price => price > 0);
        const hotelPrices = hotels.map(getPrice).filter(price => price > 0);

        const totalFlightCost = flightPrices.length ? flightPrices[0] : 0;
        const totalHotelCost = hotelPrices.length ? hotelPrices[0] : 0;
        const totalTripCost = totalFlightCost + totalHotelCost;

        return {
          totalFlightCost,
          totalHotelCost,
          totalTripCost,
          budget: 0,
          remaining: 0
        };
      }

      function getHotelAmenities(hotel) {
        const amenities =
          hotel.amenities ||
          hotel.extensions ||
          hotel.features ||
          [];

        if (Array.isArray(amenities)) {
          return amenities.map(item => String(item));
        }

        return [];
      }

      function getHotelImageFromData(hotel, name, location) {
        return (
          hotel.thumbnail ||
          hotel.image ||
          hotel.image_url ||
          hotel.images?.[0]?.thumbnail ||
          hotel.images?.[0]?.original_image ||
          hotel.images?.[0] ||
          getFallbackHotelImage(name, location)
        );
      }

      function getFallbackHotelImage(name, location) {
        const search = encodeURIComponent(`${name} ${location} hotel`);
        return `https://source.unsplash.com/800x500/?hotel,travel,${search}`;
      }

      function getFlightImage(airline) {
        const query = encodeURIComponent(`${airline} airplane`);
        return `https://source.unsplash.com/800x400/?airplane,flight,${query}`;
      }

      function formatNumber(value) {
        return Number(value || 0).toLocaleString();
      }

      function escapeHtml(value) {
        return String(value || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }
    });
  </script>
</body>
</html>